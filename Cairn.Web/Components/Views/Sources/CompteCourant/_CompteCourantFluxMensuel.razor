<div class="credits-debits">
    <label class="titre-section">@Titre</label>
    @foreach (var flux in Flux)
    {
        <div class="un-flux">
            <span class="date-flux">@flux.Date.ToString("dd MMM")</span>
            <span class="montant-flux @(IsCredit ? "vert" : "rouge")">@flux.Valeur €</span>
            <input type="text" @bind="@flux.Libelle" />
            <select class="@(flux.EstSuggestion ? "select-suggestion" : "")"
                    value="@flux.IdCategorie"
                    @onchange="(e => ChangerCategorie(flux, e))"
                    title="@(flux.EstSuggestion ? "Suggestion automatique" : "Choisissez une categorie")">
                <option value="0"></option>
                @foreach (var categorie in MicroCategories)
                {
                    <option value="@categorie.Id" selected="@(categorie.Id == flux.IdCategorie)">
                        @(flux.EstSuggestion && flux.IdCategorie == categorie.Id ? "✨" : "")
                        @categorie.Libelle
                    </option>
                }
            </select>
        </div>
    }
</div>

@code {
    [Parameter] public required List<FluxBancaireDto> Flux { get; set; }
    [Parameter] public required IEnumerable<MicroCategorieDto> MicroCategories { get; set; }
    [Parameter] public required string Titre { get; set; }
    [Parameter] public required bool IsCredit { get; set; }

    private void ChangerCategorie(FluxBancaireDto flux, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idCat))
        {
            flux.IdCategorie = idCat;
            flux.EstSuggestion = false;
        }
    }
}
